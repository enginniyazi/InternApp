# StajApp Server — Environment Variables
# Bu dosyayı .env olarak kopyalayıp değerleri kendi ortamınıza göre düzenleyin.

# PostgreSQL bağlantı URL'i
DATABASE_URL="postgresql://intern_user:intern_password@localhost:5432/internapp_db?schema=public"

# Sunucu portu
PORT=3000

# JWT gizli anahtarları (production'da güçlü, rastgele değerler kullanın)
JWT_SECRET="super-secret-jwt-key-change-me"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-me"

# SMTP ayarları (geliştirme için Mailpit: localhost:1025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
