// apps/server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW_SCHEDULED
  OFFER_SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InternshipStatus {
  DRAFT
  ACTIVE
  PASSIVE
  ARCHIVED
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         Role            @default(STUDENT)
  refreshTokenHash String?
  isSuspended      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile?
  companyProfile CompanyProfile?

  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
}

model StudentProfile {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  city             String?
  university       String?
  department       String?
  grade            String?
  gpa              Float?
  educationLevel   EducationLevel?
  internshipStatus InternshipType?
  skills           String[]        @default([])
  linkedinUrl      String?
  githubUrl        String?
  cvUrl            String?
  bio              String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  applications   Application[]
  companyReviews CompanyReview[]

  @@map("student_profiles")
}

model CompanyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  description String?
  logoUrl     String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  internships Internship[]
  reviews     CompanyReview[]

  @@map("company_profiles")
}

enum InternshipType {
  MANDATORY
  VOLUNTARY
  GRADUATE
  PART_TIME
}

enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER_PHD
}

enum WorkModel {
  ON_SITE
  HYBRID
  REMOTE
}

enum StipendType {
  UNPAID
  HALF_MINIMUM
  MINIMUM_WAGE
  ABOVE_MINIMUM
}

enum ReturnOfferProbability {
  HIGH
  MEDIUM
  LOW
  NONE
}

model Internship {
  id                   String                 @id @default(uuid())
  companyId            String
  company              CompanyProfile         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                String
  description          String
  location             String
  isRemote             Boolean                @default(false)
  requirements         String[]
  status               InternshipStatus       @default(ACTIVE)
  isFeatured           Boolean                @default(false)
  
  // Gelişmiş İlan Özellikleri
  internshipType       InternshipType         @default(MANDATORY)
  targetEducationLevel EducationLevel         @default(BACHELOR)
  targetDepartments    String[]               @default([])
  targetGrades         Int[]                  @default([])
  
  weeklyDays           Int                    @default(5)
  durationWeeks        Int                    @default(12)
  workModel            WorkModel              @default(HYBRID)
  city                 String                 @default("İstanbul")
  district             String?
  
  stipendType          StipendType            @default(MINIMUM_WAGE)
  hasMealAllowance     Boolean                @default(true)
  hasTransportation    Boolean                @default(true)
  hasEquipment         Boolean                @default(true)
  returnOfferProbability ReturnOfferProbability @default(MEDIUM)
  
  requiredSkills       String[]               @default([])
  languageRequirements String?
  
  applicationDeadline  DateTime?
  expectedStartDate    DateTime?
  quota                Int                    @default(1)

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  applications Application[]

  @@map("internships")
}

model Application {
  id           String            @id @default(uuid())
  studentId    String
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId String
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(PENDING)
  note         String?
  internalNote String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  messages   Message[]
  interviews Interview[]

  @@unique([studentId, internshipId])
  @@map("applications")
}

model Message {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("messages")
}

model Interview {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int         @default(30)
  location        String?
  meetingUrl      String?
  notes           String?
  isCompleted     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("interviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model CompanyReview {
  id               String         @id @default(uuid())
  companyId        String
  company          CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String
  isApprovedByAdmin Boolean       @default(false)
  createdAt        DateTime       @default(now())

  @@map("company_reviews")
}
